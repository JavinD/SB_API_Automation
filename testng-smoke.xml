<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Smoke test suite - runs only essential tests for quick validation -->
<suite name="Faker API Smoke Tests" parallel="methods" thread-count="3" verbose="1">
    <test name="Quick API Smoke Tests">
        <classes>
            <class name="com.sb.automation.tests.AddressesAPITest">
                <methods>
                    <include name="testDefaultAddressesRequest"/>
                    <include name="testAddressesSchemaValidation"/>
                    <include name="testAddressesWithBoundaryQuantities"/>
                </methods>
            </class>
            <class name="com.sb.automation.tests.BooksAPITest">
                <methods>
                    <include name="testDefaultBooksRequest"/>
                    <include name="testBooksSchemaValidation"/>
                    <include name="testBooksWithBoundaryQuantities"/>
                </methods>
            </class>
            <class name="com.sb.automation.tests.ProductsAPITest">
                <methods>
                    <include name="testDefaultProductsRequest"/>
                    <include name="testProductsSchemaValidation"/>
                    <include name="testProductsWithBoundaryQuantities"/>
                    <include name="testProductsDataStructure"/>
                </methods>
            </class>
        </classes>
    </test>
</suite>

