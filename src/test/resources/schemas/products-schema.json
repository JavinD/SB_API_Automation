{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["status", "code", "total", "data"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["OK", "ERROR"]
    },
    "code": {
      "type": "integer"
    },
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "price", "categories", "ean", "image"],
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "minimum": 0
          },
          "categories": {
            "type": "array",
            "items": {
              "oneOf": [
                {"type": "integer"},
                {"type": "string"}
              ]
            }
          },
          "ean": {
            "type": "string"
          },
          "image": {
            "type": "string"
          }
        }
      }
    }
  }
}

